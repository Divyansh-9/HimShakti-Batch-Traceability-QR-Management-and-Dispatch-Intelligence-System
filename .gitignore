# ─── Tooling & Workspace ────────────────────────────────────────
.agents/
tbi-guide/

# ─── Presentations & Exported Assets ───────────────────────────
*.pptx
*.ppt
*.pptm
~$*

# ─── Environment & Secrets ──────────────────────────────────────
# Broad by default, with .env.example explicitly re-included, so a new
# variant (.env.staging, backend/.env.local) can never be committed by
# accident. Secrets belong in the Vercel/Firebase dashboards.
.env
.env.*
!.env.example
*.pem
*.key
serviceAccountKey.json
firebase-adminsdk*.json
.runtimeconfig.json

# ─── Node / npm ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log

# ─── Build Output ───────────────────────────────────────────────
dist/
build/
.vite/

# ─── Deploy Tooling ─────────────────────────────────────────────
.vercel/
.firebase/
.netlify/

# ─── OS & IDE ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.suo
*.user

# ─── Logs ───────────────────────────────────────────────────────
logs/
*.log

