MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/himshakti?retryWrites=true&w=majority
PORT=5001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=AIza_YOUR_KEY_HERE
JWT_SECRET=your_jwt_secret_here

# Signs the opaque token embedded in every QR code. Optional — falls back
# to JWT_SECRET if unset, so existing deployments keep working.
#
# Set it separately in production, and then DO NOT rotate it. Tokens are
# stored on the batch and resolved by lookup, so rotating alone does not
# break issued QR codes — but re-running backfillTraceTokens.js under a
# new key overwrites stored tokens and orphans every label already
# printed on a crate.
TRACE_TOKEN_SECRET=your_trace_token_secret_here
GEMINI_CACHE_TTL_HOURS=4

# ── Shared store (Upstash Redis, HTTP REST) ────────────────────────────
# Optional. Without it the app behaves exactly as before, so local
# development and the long-lived process need no Redis at all.
#
# With it, two things start working that are broken under serverless:
#   1. Rate limiting becomes global instead of per-container. The AI
#      limiter (5 / 15 min) is what protects the Gemini free tier; split
#      across N containers it enforces nothing.
#   2. The AI report cache survives the container, so the 4-hour TTL
#      above actually takes effect instead of dying on nearly every call.
#
# Upstash specifically because it speaks HTTP — a serverless function
# cannot hold a Redis TCP socket open between invocations.
# Get both from console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_CLIENT_ID=your_google_client_id_here

# User seed passwords (used on first boot only — CHANGE before production)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║                    EMAIL CONFIGURATION                                   ║
# ║  Two options — pick ONE. Priority: Resend > Nodemailer SMTP             ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║  OPTION 1 — Resend (RECOMMENDED for Render/production)                  ║
# ║  ✅ Works on Render free tier (uses HTTPS port 443, not blocked SMTP)   ║
# ║  ✅ 3,000 emails/month free, no credit card needed                      ║
# ║                                                                          ║
# ║  Setup (2 min):                                                          ║
# ║   1. resend.com → Sign up → Dashboard → API Keys → Create Key           ║
# ║   2. Copy the key (starts with re_) → paste below                       ║
# ║   3. Optional: add your domain in Resend for a custom FROM address       ║
# ║      Without a domain, emails come FROM onboarding@resend.dev            ║
# ╚══════════════════════════════════════════════════════════════════════════╝
RESEND_API_KEY=re_YOUR_KEY_HERE
EMAIL_FROM_NAME=HimShakti Traceability
EMAIL_FROM_ADDR=onboarding@resend.dev

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  OPTION 2 — Gmail SMTP (for local development only)                     ║
# ║  ⚠️  Blocked by Render free tier (SMTP ports 465/587 are restricted)    ║
# ║                                                                          ║
# ║  Setup (2 min):                                                          ║
# ║   1. myaccount.google.com → Security → 2-Step Verification → Enable     ║
# ║   2. myaccount.google.com → Security → App Passwords → Create key       ║
# ║   3. Copy the 16-char password → paste into EMAIL_PASS below            ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM_NAME=HimShakti Traceability
# EMAIL_FROM_ADDR=your-gmail@gmail.com
